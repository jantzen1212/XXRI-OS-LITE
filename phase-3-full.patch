+#!/bin/busybox ash
+# (c) Robert Shingledecker 2010
+. /etc/init.d/xxri-functions
+useBusybox
+[ -z $1 ] && exit 1
+TARGET=$1 && EXTN=${1##/*/}
+shift 1
+APP=${EXTN%%.tcz}
+XXRI_PACKAGE_DIR=/etc/sysconfig/tcedir
+[ -d "$XXRI_PACKAGE_DIR" ] || exit 1
+[ ${TARGET} == ${EXTN} ] && TARGET=${XXRI_PACKAGE_DIR}/optional/${EXTN}
+[ ${EXTN} == ${APP} ] && TARGET=${TARGET}.tcz
+if [ ! -e /usr/local/tce.installed/${APP} ]; then
+  xxri-pkg -is ${TARGET}
+fi
+if [ -f /usr/local/share/applications/${APP}.desktop ]; then
+  RUN=`cat /usr/local/share/applications/${APP}.desktop | grep Exec | cut -f2 -d=`
+  exec ${RUN} "$@"
+else
+  [ $(which ${APP} ) ] && exec ${APP} "$@"
+fi
+
