+#!/bin/busybox ash
+# Check for optional local shutdown before actual shutdown/reboot.
+# Called from xxri-exit
+# (c) Robert Shingledecker 2006-2010
+. /etc/init.d/xxri-functions
+useBusybox
+
+[ -x /opt/shutdown.sh ] && /opt/shutdown.sh
+
+ACTION="$1"
+case "$ACTION" in
+  reboot )
+    sudo /sbin/reboot
+  ;;
+  shutdown )
+    sudo /sbin/poweroff
+  ;;
+  * )
+    sudo /sbin/poweroff
+  ;;
+esac
