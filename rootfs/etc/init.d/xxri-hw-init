#!/bin/busybox ash
# xxri-hw-init - boot-time hardware enablement (called from bootlocal.sh).
# Loads drivers, restores persisted audio/power settings and caches the
# VESA mode list before X starts.  Everything is best-effort and quiet.
{
	# extension kernel modules (ALSA, wireless...) live under
	# /usr/local/lib/modules (reached via the kernel.tclocal symlink).
	# On live boots xxri-pkg runs depmod when a module package loads; on
	# installed systems nothing does, so index them here once.  mtime is
	# useless (unsquashfs preserves package timestamps) - check content.
	if [ -d "/usr/local/lib/modules/$(uname -r)" ] && \
	   ! grep -q 'kernel\.tclocal' "/lib/modules/$(uname -r)/modules.dep" 2>/dev/null; then
		depmod -a 2>/dev/null
	fi
	# USB host controllers and storage HBAs are modular on some builds
	. /usr/local/lib/xxri/hw-lib.sh
	for d in $(pci_by_class 0x0c03) $(pci_by_class 0x01); do
		hw_load_driver "$d"
	done
	# KMS: load the DRM driver for this GPU before X starts.  Without a KMS
	# device /dev/dri is empty, X.Org's modesetting driver finds no screen, and
	# the session falls back to Xvesa - which has no XInput2, so Electron
	# applications never map a window.  Probing by PCI class covers real
	# hardware; the QEMU/VirtualBox display adapters are named explicitly.
	if [ ! -e /dev/dri/card0 ]; then
		for d in $(pci_by_class 0x0300); do hw_load_driver "$d"; done
		[ -e /dev/dri/card0 ] || for m in bochs cirrus qxl vmwgfx vboxvideo virtio-gpu simpledrm; do
			modprobe "$m" 2>/dev/null && [ -e /dev/dri/card0 ] && break
		done
	fi
	/usr/local/bin/xxri-display cache-modes
	/usr/local/bin/xxri-audio init
	G="$(sed -n 's/^GOVERNOR=//p' /usr/local/etc/xxri/power.conf 2>/dev/null)"
	[ -n "$G" ] && /usr/local/bin/xxri-power governor set "$G"
	B="$(sed -n 's/^BRIGHTNESS=//p' /usr/local/etc/xxri/power.conf 2>/dev/null)"
	[ -n "$B" ] && /usr/local/bin/xxri-power brightness set "$B"
	/usr/local/bin/xxri-network auto
	# NOTE: the GTK3/glib/gio caches are NOT generated here any more.  They are
	# built into the image by build-caches.sh so a freshly installed system is
	# already complete at first login (see rootfs-overrides/).
	# Phase 8.1: xxri Settings fully replaces the Tiny Core control panel and
	# its stand-alone config launchers - drop their .desktop entries (and the
	# duplicate gear pixmap) before the session builds the dock/menu, so only
	# xxri Settings remains.
	# Phase 9.1: the XXRI Store is the ONLY software store - drop the Tiny Core
	# package browser (apps / appbrowser / tce GUIs) too, so there is no second
	# store icon or menu entry.  The tce backend stays for internal use.
	for junk in cpanel tc-cpanel tc-config appsaudit services settime tc-wbarconf \
	            apps appbrowser tce tce-ab appsrepo; do
		rm -f "/usr/local/share/applications/tinycore-$junk.desktop" \
		      "/usr/local/share/applications/$junk.desktop" 2>/dev/null
	done
	rm -f /usr/local/share/pixmaps/cpanel.png \
	      /usr/local/bin/apps /usr/local/bin/appbrowser 2>/dev/null

	# Phase 9.2: HTTPS must work everywhere the Store runs.  ca-certificates.tcz
	# builds this bundle when it is loaded as an extension, but an image that
	# unsquashed its extensions has no such hook - build it here if missing, so
	# the live ISO, the ISO-installed system and the baked image behave alike.
	if [ ! -s /usr/local/etc/ssl/certs/ca-certificates.crt ] && \
	   [ -d /usr/local/share/ca-certificates ]; then
		mkdir -p /usr/local/etc/ssl/certs
		find /usr/local/share/ca-certificates -name '*.crt' -exec cat {} + \
			> /usr/local/etc/ssl/certs/ca-certificates.crt 2>/dev/null
		ln -sf /usr/local/etc/ssl/certs/ca-certificates.crt /usr/local/etc/ssl/cacert.pem 2>/dev/null
		ln -sf /usr/local/etc/ssl/certs/ca-certificates.crt /usr/local/etc/ssl/ca-bundle.crt 2>/dev/null
	fi
	# Phase 8.1: on an INSTALLED system (persistent root - not a live rootfs/
	# tmpfs) the installer must never be exposed.  Remove its launcher, GUI
	# binary, auto-start hook and any pre-built menu entry before the session
	# rebuilds the dock/menu.  On the Live ISO (rootfs/tmpfs) it is kept.
	case "$(awk '$2=="/"{print $3; exit}' /proc/mounts)" in
		rootfs|tmpfs) ;;
		*)
			rm -f /usr/local/share/applications/xxri-installer.desktop \
			      /usr/local/bin/xxri-installer 2>/dev/null
			for u in /home/*; do
				rm -f "$u"/.X.d/xxri-installer-live \
				      "$u"/.wmx/*/InstallxxriOSLite "$u"/.wmx/*/Install* 2>/dev/null
			done ;;
	esac
	# Toolkit caches are built INTO the image (build-caches.sh) - a release
	# image must not finish configuring itself on first boot.  The refresh
	# helper now runs only after the Store installs something new.
} >/var/log/xxri-hw-init.log 2>&1
