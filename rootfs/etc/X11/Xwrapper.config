# Xorg.wrap refuses to start the server unless the invoking user is on a
# console VT.  XXRI starts its session from the autologin shell, not a VT, so
# the wrapper would reject it and the desktop would fall back to Xvesa - which
# implements neither XInput2 nor XKB, and Chromium/Electron will not map a
# window without XInput2.
allowed_users=anybody
needs_root_rights=yes
