# xxri OS Lite dock - authoritative launcher list (Phase 10.2).
# NOTE: comments here must never contain the dock-parser tokens, because
# wbar.sh feeds this file through a string replacement that would otherwise
# turn a comment into a real entry and shift every launcher by one slot.
#
# Every launcher goes through xxri-dock-launch KEY REALCOMMAND, so clicking an
# icon whose application is already running focuses that window (restoring it
# if it was minimised) instead of starting a second copy.  KEY is also what the
# running indicator under each icon is keyed on.
#
# The icon zoom is deliberately tiny (-zoomf 1.06).  At the old 1.25 every icon
# slid sideways as the pointer approached, which moved the click target out
# from under the pointer and pulled the running indicators off their icons.
# Turning zoom off altogether is NOT an option: with -zoomf 1.0 -nanim 0 wbar
# stops resolving clicks to an icon at all and the whole dock goes dead, which
# is why this is a small number rather than none.
i: /usr/local/share/xxri-theme/wbar-bg.png
t: /usr/local/lib/X11/fonts/TTF/luxisr/9
c: wbar -bpress -nofont -pos bottom -offset 15 -isize 40 -idist 7 -zoomf 1.06 -nanim 3 -jumpf 0.0
i: /usr/local/share/pixmaps/xxri-store.png
t: Store
c: exec /usr/local/bin/xxri-dock-launch xxri-store-gui /usr/local/bin/xxri-store-gui
i: /usr/local/share/pixmaps/xxri-settings.png
t: Settings
c: exec /usr/local/bin/xxri-dock-launch xxri-settings /usr/local/bin/xxri-settings
i: /usr/local/share/pixmaps/xxri-file.png
t: Files
c: exec /usr/local/bin/xxri-dock-launch xxri-file /usr/local/bin/xxri-file
i: /usr/local/share/pixmaps/mnttool.png
t: Disks
c: exec /usr/local/bin/xxri-dock-launch xxri-settings /usr/local/bin/xxri-settings storage
i: /usr/local/share/pixmaps/aterm.png
t: Terminal
c: exec /usr/local/bin/xxri-dock-launch +aterm /usr/local/bin/aterm
i: /usr/local/share/pixmaps/xxri-browser.png
t: Browser
c: exec /usr/local/bin/xxri-dock-launch xxri-browser /usr/local/bin/xxri-browser
# The editor is Tiny Core's FLTK one and calls itself WM_CLASS "FLTK" rather
# than "editor", so that is what its indicator is keyed on.  It is prefixed
# with + (always open a new window) because "FLTK" is a class other FLTK
# surfaces share, and focusing one of those instead of opening the editor
# would be worse than opening a second editor.
i: /usr/local/share/pixmaps/editor.png
t: Editor
c: exec /usr/local/bin/xxri-dock-launch +FLTK /usr/local/bin/editor
i: /usr/local/share/pixmaps/exittc.png
t: Power
c: exec /usr/local/bin/xxri-dock-launch - /usr/local/bin/xxri-power-menu
