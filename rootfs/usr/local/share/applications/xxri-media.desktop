[Desktop Entry]
Type=Application
Name=XXRI Media
GenericName=Media Player and Viewer
Comment=Play video and music, and view pictures
Exec=/usr/local/bin/xxri-media %f
Icon=xxri-media
X-FullPathIcon=/usr/local/share/pixmaps/xxri-media.png
Terminal=false
Categories=AudioVideo;Player;Video;Viewer;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/mpeg;video/ogg;video/x-flv;video/3gpp;video/x-ms-wmv;video/x-theora+ogg;audio/mpeg;audio/mp4;audio/x-wav;audio/wav;audio/ogg;audio/x-vorbis+ogg;audio/flac;audio/x-flac;audio/aac;audio/x-ms-wma;audio/opus;audio/x-opus+ogg;image/png;image/jpeg;image/gif;image/bmp;image/x-bmp;image/vnd.microsoft.icon;image/x-icon;image/x-icns;image/svg+xml;image/svg+xml-compressed;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xpixmap;image/x-xbitmap;
StartupNotify=false
