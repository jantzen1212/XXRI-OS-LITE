# Live-ISO diagnostic v4: where do the extensions actually live on a cde boot?
( sleep 10
  R=/tmp/livediag.txt
  { echo "=== extension-source diagnostic (cde live boot) ==="
    echo "tcedir symlink -> $(readlink /etc/sysconfig/tcedir 2>/dev/null)"
    T=$(readlink /etc/sysconfig/tcedir 2>/dev/null)
    echo "contents of \$TCEDIR ($T):"; ls -a "$T" 2>/dev/null | tr '\n' ' '; echo
    echo "  \$TCEDIR/optional tcz count : $(ls "$T"/optional/*.tcz 2>/dev/null | wc -l)"
    echo "  \$TCEDIR/onboot.lst lines   : $(wc -l < "$T"/onboot.lst 2>/dev/null || echo MISSING)"
    echo "  are they symlinks?         : $(find "$T"/optional -maxdepth 1 -type l 2>/dev/null | wc -l) symlinks"
    echo
    echo "/etc/sysconfig/cde = [$(cat /etc/sysconfig/cde 2>/dev/null)]"
    C=$(cat /etc/sysconfig/cde 2>/dev/null)
    echo "  CD cde/optional tcz count  : $(ls $C/optional/*.tcz 2>/dev/null | wc -l)"
    echo
    echo "--- THE TEST install2disk performs:"
    echo "  cp -a \$TCEDIR/. -> target /tce   would copy $(ls "$T"/optional/*.tcz 2>/dev/null | wc -l) tcz"
    echo
    echo "--- gtk3 real file or loop-mount?"
    echo "  /usr/local/lib/libgtk-3.so.0 -> $(readlink -f /usr/local/lib/libgtk-3.so.0 2>/dev/null)"
    echo "  is it inside /tmp/tcloop ?    $(readlink -f /usr/local/lib/libgtk-3.so.0 2>/dev/null | grep -c tcloop)"
    echo "  fltk (copy2fs) real file?     $(readlink -f /usr/local/lib/libfltk.so.1.3 2>/dev/null)"
  } > $R 2>&1
  sync
  aterm -T "XXRI Live Diagnostic" -fn 7x14 -geometry 104x26+8+300 -e sh -c "cat $R; sleep 3600" &
) &
