####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/share/doc/qt5/examples/webenginewidgets/simplebrowser || mkdir -p $(INSTALL_ROOT)/usr/local/share/doc/qt5/examples/webenginewidgets/simplebrowser
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/local/share/doc/qt5/examples/webenginewidgets/simplebrowser/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/local/share/doc/qt5/examples/webenginewidgets/simplebrowser/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/local/share/doc/qt5/examples/webenginewidgets/simplebrowser/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/share/doc/qt5/examples/webenginewidgets/simplebrowser/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

