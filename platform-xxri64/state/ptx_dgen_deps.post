PTXDIST_HASHLIST_DATA += CONFIG: HOST_PKGCONF $(HOST_PKGCONF_CONFIG)\n
else
$(STATEDIR)/host-pkgconf.prepare: $(HOST_PKGCONF_CONFIG)
endif
endif
ifneq ($(wildcard $(HOST_PKGCONF_MESON_CROSS_FILE)),)
PTXDIST_HASHLIST_DATA += CONFIG: HOST_PKGCONF $(HOST_PKGCONF_MESON_CROSS_FILE)\n
endif
endif
$(foreach part,$(HOST_ACL_PARTS), $(eval $(if $($(part)_SOURCE),$(eval $($(part)_SOURCE) := $(part)))))
ifneq ($(HOST_ACL),)
ifneq ($(HOST_ACL_PATCHES),)
HOST_ACL_PATCH_DIRS := $(call ptx/in-path-all,PTXDIST_PATH_PATCHES,$(HOST_ACL_PATCHES))
else
HOST_ACL_PATCH_DIRS := $(call ptx/in-path-all,PTXDIST_PATH_PATCHES,$(HOST_ACL))
endif
ifeq ($(HOST_ACL_PATCH_DIRS),)
undefine HOST_ACL_PATCH_DIRS
else
HOST_ACL_PATCH_DIR := $(firstword $(HOST_ACL_PATCH_DIRS))
ifdef PTXDIST_SETUP_ONCE
PTXDIST_HASHLIST_DATA += PATCHES: HOST_ACL $(HOST_ACL_PATCH_DIR)\n
endif
endif
ifneq ($(HOST_ACL_SOURCE),)
ifdef PTXDIST_SETUP_ONCE
_tmp :=$(foreach part, $(HOST_ACL_PARTS),$($(part)_MD5) $(notdir $($(part)_SOURCE)))
$(file >>/tmp/ptxdist.x3PABh/pkghash-HOST_ACL_EXTRACT,$(_tmp))
endif
endif
endif
ifdef PTXDIST_SETUP_ONCE
HOST_ACL_CONFIG := $(HOST_ACL_CONFIG)
ifeq ($(HOST_ACL_CONFIG),)
undefine HOST_ACL_CONFIG
endif
ifneq ($(filter /%,$(HOST_ACL_CONFIG)),)
ifneq ($(wildcard $(HOST_ACL_CONFIG)),)
PTXDIST_HASHLIST_DATA += CONFIG: HOST_ACL $(HOST_ACL_CONFIG)\n
else
$(STATEDIR)/host-acl.prepare: $(HOST_ACL_CONFIG)
endif
endif
ifneq ($(wildcard $(HOST_ACL_MESON_CROSS_FILE)),)
PTXDIST_HASHLIST_DATA += CONFIG: HOST_ACL $(HOST_ACL_MESON_CROSS_FILE)\n
endif
endif
ifdef PTXDIST_SETUP_ONCE
$(call ptx/force-shell, echo -e '$(PTXDIST_HASHLIST_DATA)' >> /tmp/ptxdist.x3PABh/pkghash.list)
$(call ptx/force-sh, $(PTXDIST_LIB_DIR)/ptxd_make_pkghash.awk /tmp/ptxdist.x3PABh/pkghash.list)
endif
$(call ptx/force-sh, md5sum /tmp/ptxdist.x3PABh/pkghash-* | sed 's;^\([a-z0-9]*\).*pkghash-\(.*\)$$;\2_CFGHASH := \1;' > /tmp/ptxdist.x3PABh/pkghash.make)
include /tmp/ptxdist.x3PABh/pkghash.make
