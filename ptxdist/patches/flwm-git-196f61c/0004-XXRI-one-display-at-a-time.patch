From: XXRI OS Team
Subject: [PATCH] One display at a time: maximise, placement and screen changes

With two displays extended, the root window spans both, so maximise
filled both screens, new windows were placed anywhere on the bounding
box and the dock band was kept free on every display. And the root
window was measured once: after a display was added or removed by RandR
windows stayed clamped to the old size, or sat on a display that was
gone.

Read the RandR 1.5 monitors. Maximise fills the display under the
window's centre, new windows go to the display the pointer is on, and
the dock band is only kept free on the primary display (where the dock
is; xxri-display keeps it at 0,0). On a RandR screen change the root
size, the monitor list and every window follow: maximised windows fill
their display again, and a window less than a quarter visible (or with
its titlebar off every display) comes back to the primary.
---
--- a/Frame.C
+++ b/Frame.C
@@ -41,6 +41,103 @@
 #ifdef XXRI
 // defined with the rest of the XXRI decoration code, used by placement too
 static int xxri_dock_reserve();
+
+// ---- displays
+// With an extended layout the root window spans every display, but the dock
+// lives on the primary one and maximise, placement and the dock band belong
+// to a single display. RandR 1.5 monitors, re-read after every screen change
+// (xxri_screen_changed, from main.C). xxri-display keeps the primary at 0,0.
+#include <X11/extensions/Xrandr.h>
+extern Fl_Window* Root;
+struct XxriMon { int x, y, w, h, primary; };
+#define XXRI_MAX_MONS 8
+static XxriMon xxri_mons[XXRI_MAX_MONS];
+static int xxri_nmons = -1;
+
+static void xxri_load_monitors() {
+  if (xxri_nmons >= 0) return;
+  xxri_nmons = 0;
+  int ev, er, n = 0, prim = 0;
+  if (XRRQueryExtension(fl_display, &ev, &er)) {
+    XRRMonitorInfo* m = XRRGetMonitors(fl_display, RootWindow(fl_display, fl_screen), True, &n);
+    for (int i = 0; m && i < n && xxri_nmons < XXRI_MAX_MONS; i++) {
+      if (m[i].width <= 0 || m[i].height <= 0) continue;
+      XxriMon& o = xxri_mons[xxri_nmons++];
+      o.x = m[i].x; o.y = m[i].y; o.w = m[i].width; o.h = m[i].height;
+      o.primary = m[i].primary && !prim;
+      prim |= o.primary;
+    }
+    if (m) XRRFreeMonitors(m);
+  }
+  if (!xxri_nmons) {	// no RandR (Xfbdev): the whole screen
+    XxriMon& o = xxri_mons[xxri_nmons++];
+    o.x = Root->x(); o.y = Root->y(); o.w = Root->w(); o.h = Root->h();
+    o.primary = 1;
+  } else if (!prim) {	// none flagged: the one at the origin, else the first
+    int k = 0;
+    for (int i = 0; i < xxri_nmons; i++)
+      if (xxri_mons[i].x == 0 && xxri_mons[i].y == 0) { k = i; break; }
+    xxri_mons[k].primary = 1;
+  }
+}
+
+static const XxriMon& xxri_primary_monitor() {
+  xxri_load_monitors();
+  for (int i = 0; i < xxri_nmons; i++) if (xxri_mons[i].primary) return xxri_mons[i];
+  return xxri_mons[0];
+}
+
+static int xxri_mon_has(const XxriMon& m, int X, int Y) {
+  return X >= m.x && X < m.x + m.w && Y >= m.y && Y < m.y + m.h;
+}
+
+// the display holding X,Y - the primary first, mirrored displays overlap it -
+// else the primary
+static const XxriMon& xxri_monitor_at(int X, int Y) {
+  const XxriMon& p = xxri_primary_monitor();
+  if (xxri_mon_has(p, X, Y)) return p;
+  for (int i = 0; i < xxri_nmons; i++)
+    if (xxri_mon_has(xxri_mons[i], X, Y)) return xxri_mons[i];
+  return p;
+}
+
+static const XxriMon& xxri_pointer_monitor() {
+  XWindow r, c; int rx = 0, ry = 0, wx, wy; unsigned int mask;
+  if (XQueryPointer(fl_display, RootWindow(fl_display, fl_screen), &r, &c,
+		    &rx, &ry, &wx, &wy, &mask))
+    return xxri_monitor_at(rx, ry);
+  return xxri_primary_monitor();
+}
+
+// what a window may fill on that display: all of it, less the dock band on
+// the primary
+static void xxri_work_area(const XxriMon& m, int& X, int& Y, int& W, int& H) {
+  X = m.x; Y = m.y; W = m.w; H = m.h;
+  if (m.primary && H - xxri_dock_reserve() >= 200) H -= xxri_dock_reserve();
+}
+
+// pixels of X,Y,W,H on some display
+static long xxri_visible_area(int X, int Y, int W, int H) {
+  xxri_load_monitors();
+  long a = 0;
+  for (int i = 0; i < xxri_nmons; i++) {
+    const XxriMon& m = xxri_mons[i];
+    int x0 = X > m.x ? X : m.x, x1 = X+W < m.x+m.w ? X+W : m.x+m.w;
+    int y0 = Y > m.y ? Y : m.y, y1 = Y+H < m.y+m.h ? Y+H : m.y+m.h;
+    if (x1 > x0 && y1 > y0) a += (long)(x1-x0) * (y1-y0);
+  }
+  return a;
+}
+
+// RandR said the screen changed: new root size, new displays, and no window
+// left where nobody can see it
+void xxri_screen_changed(int W, int H) {
+  // the cached size only: Fl_Window::resize would ask the server to
+  // configure the root window
+  Root->Fl_Widget::resize(0, 0, W, H);
+  xxri_nmons = -1;
+  for (Frame* f = Frame::first; f; f = f->next) f->xxri_refit();
+}
 #endif
 
