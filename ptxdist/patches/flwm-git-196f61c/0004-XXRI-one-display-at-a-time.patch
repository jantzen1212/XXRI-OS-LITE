 // Resize and/or move the window.  The size is given for the frame, not
 // the contents.  This also sets the buttons on/off as needed:
 
+#ifdef XXRI
+void Frame::xxri_refit() {
+  if (xxri_maxed) {	// maximised: fill its display again, at the new size
+    int X, Y, W, H;
+    xxri_work_area(xxri_monitor_at(x() + w()/2, y() + h()/2), X, Y, W, H);
+    set_size(X, Y, W, H, 0);
+    // a restore rectangle on a display that went away comes back on this one
+    if (xxri_visible_area(xxri_rx, xxri_ry, xxri_rw, xxri_rh) < (long)xxri_rw * xxri_rh / 4) {
+      xxri_rx = X + 40; xxri_ry = Y + 40;
+    }
+    return;
+  }
+  // less than a quarter of it (or no titlebar) on any display: bring it to
+  // the primary, keeping its size where that fits
+  if (xxri_visible_area(x(), y(), w(), h()) >= (long)w() * h() / 4 &&
+      xxri_visible_area(x(), y(), w(), top > 8 ? top : 8) > 0) return;
+  int X, Y, W, H;
+  xxri_work_area(xxri_primary_monitor(), X, Y, W, H);
+  int nw = w() > W ? W : w(), nh = h() > H ? H : h();
+  set_size(X + (W - nw)/2, Y + (H - nh)/2, nw, nh, 0);
+}
+#endif
