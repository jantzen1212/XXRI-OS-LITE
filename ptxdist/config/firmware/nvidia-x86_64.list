# NVIDIA firmware for nouveau, x86_64 only, on top of nvidia.list
# (rules/xxri-firmware-nvidia.make; the 32-bit system ships nvidia.list alone).
#
# Names are what nouveau declares (MODULE_FIRMWARE, scripts/xxri-fw-requested.sh),
# minus what nvidia.list has, resolved against linux-firmware 20260810 by
# scripts/xxri-fw-select.py.
#
# Scope: the signed (non-GSP) firmware for acceleration on Pascal (GTX 10),
# Volta, Turing (GTX 16 / RTX 20) and Ampere (RTX 30).
# Left out: GSP-RM (/gsp/, ~500 MB). Ada (RTX 40) and newer need it, so nouveau
# leaves those on the firmware framebuffer; Turing and Ampere run without it.
nvidia/ga102/acr/ucode_ahesasc.bin
nvidia/ga102/acr/ucode_asb.bin
nvidia/ga102/acr/ucode_unload.bin
nvidia/ga102/gr/fecs_bl.bin
nvidia/ga102/gr/fecs_sig.bin
nvidia/ga102/gr/gpccs_bl.bin
nvidia/ga102/gr/gpccs_sig.bin
