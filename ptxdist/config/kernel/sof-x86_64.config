# XXRI additions to Tiny Core's config-6.12.11-tinycore64 (rules/xxri-kernel.make).
# Adds ALSA SoC with Sound Open Firmware, SoundWire and the AMD ACP microphone
# drivers, for laptops whose speakers/mics sit behind an audio DSP (Intel 8th gen
# and newer with DMIC/SoundWire, Ryzen with ACP). Tiny Core builds all of sound as
# modules (SOUND=m), so nearly all of this is modules too. The only built-in
# additions are REGMAP_IRQ (CS35L41 amps, CS42L43 codec) and
# GPIO_SWNODE_UNDEFINED (CS42L43's SPI bus). Tiny Core's module packages
# (graphics, wireless, ...) keep working because scripts/xxri-kabi-check.py
# fails the build if config values or exported symbols differ from theirs.
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_APOLLOLAKE=m
CONFIG_SND_SOC_SOF_GEMINILAKE=m
CONFIG_SND_SOC_SOF_CANNONLAKE=m
CONFIG_SND_SOC_SOF_COFFEELAKE=m
CONFIG_SND_SOC_SOF_COMETLAKE=m
CONFIG_SND_SOC_SOF_ICELAKE=m
CONFIG_SND_SOC_SOF_JASPERLAKE=m
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ELKHARTLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
# the older Intel DSP drivers stay off, snd-intel-dspcfg picks SOF
# CONFIG_SND_SOC_INTEL_CATPT is not set
# CONFIG_SND_SOC_INTEL_SKYLAKE is not set
# CONFIG_SND_SOC_INTEL_AVS is not set
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=m
CONFIG_SND_SOC_INTEL_SOF_CS42L42_MACH=m
CONFIG_SND_SOC_INTEL_SOF_PCM512x_MACH=m
CONFIG_SND_SOC_INTEL_SOF_ES8336_MACH=m
CONFIG_SND_SOC_INTEL_SOF_NAU8825_MACH=m
CONFIG_SND_SOC_INTEL_SOF_DA7219_MACH=m
CONFIG_SND_SOC_INTEL_SOF_SSP_AMP_MACH=m
CONFIG_SND_SOC_INTEL_SOF_CML_RT1011_RT5682_MACH=m
CONFIG_SND_SOC_INTEL_EHL_RT5660_MACH=m
CONFIG_SND_SOC_DMIC=m
# AMD: ACP PDM microphones (no firmware needed) and SOF on ACP
CONFIG_SND_SOC_AMD_ACP=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_RENOIR_MACH=m
CONFIG_SND_SOC_AMD_ACP5x=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
CONFIG_SND_AMD_ACP_CONFIG=m
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SOC_AMD_ACP_PCI=m
CONFIG_SND_AMD_ASOC_RENOIR=m
CONFIG_SND_AMD_ASOC_REMBRANDT=m
CONFIG_SND_AMD_ASOC_ACP63=m
CONFIG_SND_AMD_ASOC_ACP70=m
CONFIG_SND_SOC_AMD_MACH_COMMON=m
CONFIG_SND_SOC_AMD_LEGACY_MACH=m
CONFIG_SND_SOC_AMD_SOF_MACH=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_RENOIR=m
CONFIG_SND_SOC_SOF_AMD_REMBRANDT=m
CONFIG_SND_SOC_SOF_AMD_VANGOGH=m
CONFIG_SND_SOC_SOF_AMD_ACP63=m
# HDA speaker amps (Cirrus CS35L41/CS35L56, TI TAS2781) found in many 2021+
# laptops, plus the ACPI multi-instantiate and LPSS SPI drivers they sit behind
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L41_SPI=m
CONFIG_SND_HDA_SCODEC_CS35L56_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L56_SPI=m
CONFIG_SND_HDA_SCODEC_TAS2781_I2C=m
CONFIG_SERIAL_MULTI_INSTANTIATE=m
CONFIG_SPI_PXA2XX=m
# New =y options, allowed for scripts/xxri-kabi-check.py. First the bools that
# are only compiled into the sound modules (SoC core, SOF core, Intel machines):
# xxri-kabi-allow: CONFIG_SND_SOC_COMPRESS CONFIG_SND_SOC_TOPOLOGY CONFIG_SND_SOC_SOF_TOPLEVEL
# xxri-kabi-allow: CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL CONFIG_SND_SOC_SOF_IPC3 CONFIG_SND_SOC_SOF_IPC4
# xxri-kabi-allow: CONFIG_SND_SOC_SOF_PROBE_WORK_QUEUE CONFIG_SND_SOC_SOF_HDA_LINK
# xxri-kabi-allow: CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC CONFIG_SND_SOC_INTEL_SST_TOPLEVEL
# xxri-kabi-allow: CONFIG_SND_SOC_INTEL_MACH CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES
# and the two that really end up in the kernel image (new code only, no changed structures):
# xxri-kabi-allow: CONFIG_REGMAP_IRQ CONFIG_GPIO_SWNODE_UNDEFINED
