#!/bin/busybox ash
# xxri-input - input backend (xxri Hardware Layer).
#
#   xxri-input devices [--json]
#   xxri-input status [--json]
#   xxri-input set-repeat DELAY_MS RATE_HZ
#   xxri-input set-mouse-speed ACCEL [THRESHOLD]
#   xxri-input pointer-speed SPEED   (-1 slowest .. 1 fastest, 0 = default)
#   xxri-input natural-scroll on|off
#   xxri-input set-layout CODE   (console keymap; kmaps package included)
#   xxri-input set-xkb LAYOUT [VARIANT]   (X layout, applied at the next X start)
#   xxri-input layouts [--json]
#   xxri-input apply             (session helper: re-apply saved settings)
. /usr/local/lib/xxri/hw-lib.sh

JSON=0
for a in "$@"; do [ "$a" = "--json" ] && JSON=1; done

cmd_devices() {
	# /proc/bus/input/devices: kernel-stable records
	a_new
	awk -v RS= -v js=$JSON '
	{
		name=""; hand=""; ev=""
		n=split($0, l, "\n")
		for (i=1;i<=n;i++) {
			if (l[i] ~ /^N: Name=/) { name=l[i]; sub(/^N: Name="/,"",name); sub(/"$/,"",name) }
			if (l[i] ~ /^H: Handlers=/) { hand=l[i]; sub(/^H: Handlers=/,"",hand) }
			if (l[i] ~ /^B: EV=/) { ev=l[i]; sub(/^B: EV=/,"",ev) }
		}
		type="other"
		if (hand ~ /kbd/) type="keyboard"
		if (hand ~ /mouse/) type="mouse"
		if (name ~ /[Tt]ouchpad|[Ss]ynaptics|ETPS/) type="touchpad"
		gsub(/"/,"\\\"",name)
		if (js==1) printf "{\"name\":\"%s\",\"type\":\"%s\",\"handlers\":\"%s\"}\n", name, type, hand
		else printf "%-10s %s\n", type, name
	}' /proc/bus/input/devices 2>/dev/null > "$XXRI_TMP/inp.$$"
	if [ $JSON = 1 ]; then
		l="$(tr '\n' ',' < "$XXRI_TMP/inp.$$" | sed 's/,$//')"
		j_root input "\"devices\":[$l]"
	else cat "$XXRI_TMP/inp.$$"; fi
	rm -f "$XXRI_TMP/inp.$$"
}

cmd_status() {
	delay="$(cfg_get input REPEAT_DELAY 500)"
	rate="$(cfg_get input REPEAT_RATE 25)"
	accel="$(cfg_get input MOUSE_ACCEL 2)"
	thresh="$(cfg_get input MOUSE_THRESH 4)"
	nat="$(cfg_get input NATURAL_SCROLL 0)"
	pspeed="$(cfg_get input POINTER_SPEED 0)"
	lay="$(sed -n 's/^KEYMAP=//p' /etc/sysconfig/keymap 2>/dev/null)"
	xkb="$(sed -n 's/^XKB=//p' /etc/sysconfig/xkb 2>/dev/null)"
	if [ $JSON = 1 ]; then
		j_new
		j_num repeat_delay_ms "$delay"; j_num repeat_rate_hz "$rate"
		j_num mouse_accel "$accel"; j_num mouse_threshold "$thresh"
		j_bool natural_scroll "$nat"
		j_num pointer_speed "$pspeed"
		j_str keyboard_layout "${lay:-us}"
		j_str x_keyboard_layout "${xkb:-us}"
		j_str note "settings apply to the X session via xset/xmodmap; touchpad gestures need a libinput/Xorg build"
		j_root input "\"status\":$(j_obj)"
	else
		echo "repeat: ${delay}ms delay, ${rate}Hz   mouse: accel $accel thresh $thresh"
		echo "natural scroll: $([ "$nat" = 1 ] && echo on || echo off)   layout: ${lay:-us}"
	fi
}

cmd_set_repeat() {
	[ -n "$2" ] || { echo "usage: xxri-input set-repeat DELAY_MS RATE_HZ" >&2; return 1; }
	cfg_set input REPEAT_DELAY "$1"; cfg_set input REPEAT_RATE "$2"
	[ -n "$DISPLAY" ] && xset r rate "$1" "$2" 2>/dev/null
	echo "keyboard repeat: ${1}ms delay, ${2}/s"
}

# The X server's libinput driver ignores xset m and the core button map for
# smooth scrolling, so its pointers are set through their own properties:
#   libinput Accel Speed (-1..1), libinput Natural Scrolling Enabled (0/1).
# Applies to every pointer that has the property (mice, touchpads, trackpoints,
# also ones plugged in earlier in the session); returns how many it set.
# No such device (the framebuffer X server, kdrive): 0, and the caller falls
# back to xset/xmodmap. Never both: the two would cancel out.
li_set() { # PROPERTY VALUE
	n=0
	command -v xinput >/dev/null 2>&1 || { echo 0; return; }
	for id in $(xinput list --id-only 2>/dev/null); do
		xinput list-props "$id" 2>/dev/null | grep -q "$1 (" || continue
		xinput set-prop "$id" "$1" "$2" 2>/dev/null && n=$((n + 1))
	done
	echo "$n"
}
# speed -1..1 -> the core accel multiplier for the fallback: 2 * 4^speed, so 0 stays xset's default 2
speed_accel() { awk -v v="$1" 'BEGIN { a = 2 * exp(2 * v * log(2)); printf "%d", (a < 1 ? 1 : a + 0.5) }'; }
apply_speed() {
	sp="$(cfg_get input POINTER_SPEED 0)"
	[ -n "$DISPLAY" ] || return 0
	if [ "$(li_set "libinput Accel Speed" "$sp")" = 0 ]; then
		xset m "$(speed_accel "$sp")" "$(cfg_get input MOUSE_THRESH 4)" 2>/dev/null
	fi
}
apply_scroll() {
	[ -n "$DISPLAY" ] || return 0
	want="$(cfg_get input NATURAL_SCROLL 0)"
	if [ "$(li_set "libinput Natural Scrolling Enabled" "$want")" = 0 ]; then
		if [ "$want" = 1 ]; then xmodmap -e "pointer = 1 2 3 5 4 6 7 8 9" 2>/dev/null
		else xmodmap -e "pointer = 1 2 3 4 5 6 7 8 9" 2>/dev/null; fi
	fi
}

cmd_set_mouse() {
	[ -n "$1" ] || { echo "usage: xxri-input set-mouse-speed ACCEL [THRESHOLD]" >&2; return 1; }
	cfg_set input MOUSE_ACCEL "$1"; cfg_set input MOUSE_THRESH "${2:-4}"
	[ -n "$DISPLAY" ] && xset m "$1" "${2:-4}" 2>/dev/null
	echo "mouse speed: accel $1, threshold ${2:-4}"
}

cmd_pointer_speed() {
	if ! echo "$1" | grep -qE '^-?[0-9](\.[0-9]+)?$' || \
	   [ "$(awk -v v="$1" 'BEGIN { print (v >= -1 && v <= 1) ? 1 : 0 }')" != 1 ]; then
		echo "usage: xxri-input pointer-speed SPEED   (-1 .. 1, 0 = default)" >&2; return 1
	fi
	cfg_set input POINTER_SPEED "$1"
	apply_speed
	echo "pointer speed: $1"
}

cmd_natural() {
	case "$1" in
		on)  cfg_set input NATURAL_SCROLL 1 ;;
		off) cfg_set input NATURAL_SCROLL 0 ;;
		*) echo "usage: xxri-input natural-scroll on|off" >&2; return 1 ;;
	esac
	apply_scroll
	echo "natural scrolling: $1"
}

cmd_layouts() {
	if [ $JSON = 1 ]; then
		a_new
		for k in /usr/share/kmap/*.kmap; do
			[ -e "$k" ] || continue
			n="${k##*/}"; a_add "\"${n%.kmap}\""
		done
		j_root input "\"layouts\":$(a_out)"
	else
		ls /usr/share/kmap 2>/dev/null | sed 's/\.kmap$//'
	fi
}

cmd_set_layout() {
	[ -f "/usr/share/kmap/$1.kmap" ] || { echo "unknown layout: $1 (see xxri-input layouts)" >&2; return 1; }
	sudo_if sh -c "loadkmap < /usr/share/kmap/$1.kmap"
	sudo_if sh -c "echo 'KEYMAP=$1' > /etc/sysconfig/keymap"
	echo "console keyboard layout: $1 (the desktop's keyboard is set with set-xkb)"
}

# X layout: saved in /etc/sysconfig/xkb (xxri-config rewrites the InputClass
# file from it at boot), read when X starts
cmd_set_xkb() {
	. /usr/local/lib/xxri/locale.sh
	[ -n "$1" ] || { echo "usage: xxri-input set-xkb LAYOUT [VARIANT]   e.g. pt, br, us intl" >&2; return 1; }
	xxri_xkb_ok "$1" "$2" || { echo "unknown X keyboard layout: $1 $2 (see $XXRI_XKB_DIR/symbols)" >&2; return 1; }
	if [ -n "$2" ] && ! grep -q "xkb_symbols \"$2\"" "$XXRI_XKB_DIR/symbols/${1%%,*}" 2>/dev/null; then
		echo "layout $1 has no variant $2" >&2; return 1
	fi
	sudo_if sh -c "echo 'XKB=$1${2:+:$2}' > /etc/sysconfig/xkb"
	sudo_if sh -c ". /usr/local/lib/xxri/locale.sh; xxri_xkb_apply '$1' '$2'"
	echo "X keyboard layout: $1${2:+ ($2)} (applies at the next desktop start)"
}

cmd_apply() { # called from the X session hook
	[ -n "$DISPLAY" ] || return 0
	xset r rate "$(cfg_get input REPEAT_DELAY 500)" "$(cfg_get input REPEAT_RATE 25)" 2>/dev/null
	apply_speed
	apply_scroll
	return 0
}

case "$1" in
	devices) cmd_devices ;;
	status) cmd_status ;;
	set-repeat) shift; cmd_set_repeat "$@" ;;
	set-mouse-speed) shift; cmd_set_mouse "$@" ;;
	pointer-speed) shift; cmd_pointer_speed "$@" ;;
	natural-scroll) shift; cmd_natural "$@" ;;
	layouts) cmd_layouts ;;
	set-layout) shift; cmd_set_layout "$@" ;;
	set-xkb) shift; cmd_set_xkb "$@" ;;
	apply) cmd_apply ;;
	*) echo "usage: xxri-input devices|status|set-repeat D R|set-mouse-speed A [T]|pointer-speed S|natural-scroll on|off|layouts|set-layout CODE|set-xkb LAYOUT [VARIANT]|apply [--json]" >&2; exit 1 ;;
esac
